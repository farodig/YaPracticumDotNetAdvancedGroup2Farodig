{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=eventDb;Username=postgres;Password=postgres"
  },
  "TokenSettings": {
    "Issuer": "EventApiIssuer",
    "Audience": "EventApiAudience",
    "ExpirationMin": 60
  },
  "Broker": {
    "BootstrapServers": "localhost:9092",
    "SessionTimeoutSeconds": 60000,
    "HeartbeatIntervalMs": 5000
  }
}
